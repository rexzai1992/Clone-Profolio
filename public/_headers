# Cloudflare static-asset headers (copied into out/ by `next build`).

# Next.js build output is content-hashed, so it can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep their file names across edits (new versions get a new name, e.g. -v2),
# so cache for a day and refresh in the background after that.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
