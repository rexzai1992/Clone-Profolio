{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "profolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/assets/*"]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "profolio-assets"
    }
  ],
  "routes": [
    {
      "pattern": "kaynx1.com/*",
      "zone_name": "kaynx1.com"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
